GUIDE/

# Trivy binary is 168 MB — exceeds GitHub's 100 MiB per-file hard limit.
# It is NOT stored in git; it ships inside the .deb release asset and can be
# re-fetched any time via scripts/setup-offline.sh (one-time, documented).
aegis-preflight-app/resources/bin/trivy

# JavaFX jmods fetched once by scripts/build-deb.sh to assemble the bundled
# jlink runtime image (re-downloadable, pinned to pom javafx.version).
tools/

# Packed LLM engine + model (llama.cpp llama-server + GGUF weights, ~1.2 GB).
# NOT stored in git — far beyond GitHub's per-file limits. build-deb.sh and
# setup-offline.sh fetch pinned versions into this layout; the .deb release
# asset ships them.
aegis-preflight-app/resources/llm/
